<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Luz Rural | Energía Sostenible</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-zinc-950 text-zinc-200 font-sans antialiased selection:bg-amber-400 selection:text-zinc-950">

    <!-- Navbar -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-zinc-950/80 backdrop-blur border-b border-zinc-800">
        <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
            <span class="text-lg font-extrabold tracking-tight text-white">LUZ<span class="text-amber-400">RURAL</span></span>
            <a href="#contacto" class="px-4 py-2 rounded-full text-xs font-bold bg-amber-400 text-zinc-950 hover:bg-amber-300 transition">Unirse</a>
        </div>
    </header>

    <!-- Hero / Demostrador -->
    <section class="pt-32 pb-16 px-6 max-w-6xl mx-auto grid md:grid-cols-2 gap-12 items-center">
        <div class="space-y-6 text-center md:text-left">
            <span class="px-3 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-amber-400 text-xs font-semibold">
                ☀️ Solución Energética Comunitaria
            </span>
            <h1 class="text-4xl sm:text-5xl font-extrabold text-white leading-tight">
                Llevando luz y desarrollo a <span class="text-amber-400">zonas rurales</span>
            </h1>
            <p class="text-zinc-400 text-sm leading-relaxed">
                Más de 600 millones de personas viven sin electricidad. Esto frena la educación, la salud y la economía local. La solución son las microrredes solares comunitarias.
            </p>
            <button id="toggleBtn" class="px-6 py-3 rounded-xl bg-amber-400 text-zinc-950 font-bold hover:bg-amber-300 transition shadow-lg shadow-amber-400/20">
                Encender Energía Solar ⚡
            </button>
        </div>

        <!-- Tarjeta Visual Interactiva -->
        <div id="cardBox" class="bg-zinc-900 border border-zinc-800 rounded-3xl p-8 text-center transition-all duration-500">
            <div id="statusIcon" class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-red-500/10 border border-red-500/20 text-red-400 flex items-center justify-center">
                <i data-lucide="moon" class="w-8 h-8"></i>
            </div>
            <h3 id="cardTitle" class="text-xl font-bold text-white mb-2">Comunidad a Oscuras</h3>
            <p id="cardDesc" class="text-zinc-400 text-xs">Los niños estudian con velas y no hay refrigeración para vacunas.</p>
        </div>
    </section>

    <!-- La Problemática y Solución -->
    <section class="py-16 px-6 max-w-6xl mx-auto border-t border-zinc-800/60 grid md:grid-cols-2 gap-8">
        <div class="bg-zinc-900/50 border border-zinc-800 p-8 rounded-2xl">
            <h3 class="text-lg font-bold text-red-400 mb-3">❌ El Problema</h3>
            <ul class="space-y-2 text-sm text-zinc-400">
                <li>• Pérdida de vacunas y medicamentos por falta de frío.</li>
                <li>• Estudiantes sin acceso a estudio nocturno ni internet.</li>
                <li>• Uso costoso y contaminante de generadores a diésel.</li>
            </ul>
        </div>
        <div class="bg-zinc-900/50 border border-zinc-800 p-8 rounded-2xl">
            <h3 class="text-lg font-bold text-amber-400 mb-3">✅ Nuestra Solución</h3>
            <ul class="space-y-2 text-sm text-zinc-400">
                <li>• Paneles solares modulares de alta resistencia.</li>
                <li>• Baterías de litio (LiFePO4) para respaldo 24/7.</li>
                <li>• Capacitación técnica comunitaria para su autonomía.</li>
            </ul>
        </div>
    </section>

    <!-- Contacto / CTA -->
    <section id="contacto" class="py-16 px-6 max-w-xl mx-auto text-center">
        <div class="bg-zinc-900 border border-zinc-800 p-8 rounded-3xl">
            <h3 class="text-2xl font-bold text-white mb-2">¿Quieres llevar este proyecto a tu comunidad?</h3>
            <p class="text-zinc-400 text-xs mb-6">Déjanos tu correo y nos pondremos en contacto.</p>
            <form onsubmit="event.preventDefault(); alert('¡Mensaje enviado con éxito!');" class="space-y-4">
                <input type="email" required placeholder="Tu correo electrónico" class="w-full px-4 py-3 rounded-xl bg-zinc-950 border border-zinc-800 text-white text-sm focus:outline-none focus:border-amber-400">
                <button type="submit" class="w-full py-3 rounded-xl bg-amber-400 text-zinc-950 font-bold hover:bg-amber-300 text-sm transition">Enviar Solicitud</button>
            </form>
        </div>
    </section>

    <!-- Script Simple -->
    <script>
        lucide.createIcons();

        let active = false;
        const btn = document.getElementById('toggleBtn');
        const cardBox = document.getElementById('cardBox');
        const statusIcon = document.getElementById('statusIcon');
        const cardTitle = document.getElementById('cardTitle');
        const cardDesc = document.getElementById('cardDesc');

        btn.addEventListener('click', () => {
            active = !active;
            if (active) {
                cardBox.className = "bg-amber-500/10 border border-amber-500/40 rounded-3xl p-8 text-center transition-all duration-500 shadow-xl shadow-amber-500/10";
                statusIcon.className = "w-16 h-16 mx-auto mb-4 rounded-2xl bg-amber-400/20 border border-amber-400/40 text-amber-400 flex items-center justify-center";
                statusIcon.innerHTML = '<i data-lucide="sun" class="w-8 h-8"></i>';
                cardTitle.textContent = "¡Comunidad Electrificada!";
                cardDesc.textContent = "Luces LED encendidas, refrigeración médica y conectividad activa.";
                btn.textContent = "Apagar Energía 🌙";
            } else {
                cardBox.className = "bg-zinc-900 border border-zinc-800 rounded-3xl p-8 text-center transition-all duration-500";
                statusIcon.className = "w-16 h-16 mx-auto mb-4 rounded-2xl bg-red-500/10 border border-red-500/20 text-red-400 flex items-center justify-center";
                statusIcon.innerHTML = '<i data-lucide="moon" class="w-8 h-8"></i>';
                cardTitle.textContent = "Comunidad a Oscuras";
                cardDesc.textContent = "Los niños estudian con velas y no hay refrigeración para vacunas.";
                btn.textContent = "Encender Energía Solar ⚡";
            }
            lucide.createIcons();
        });
    </script>
</body>
</html>
